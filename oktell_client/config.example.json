{
  "api_base_url": "https://icore.example.com",
  "oktell": {
    "url": "https://oktell.example.com/",
    "autologin": true,
    "selectors": {
      "login": "input[name='login'], input#login, input[type='text']",
      "password": "input[name='password'], input#password, input[type='password']",
      "submit": "button[type='submit'], input[type='submit'], .login-button"
    },
    "busy_state_strings": [
      "talk",
      "dial",
      "call",
      "ring"
    ],
    "session_keys": [
      "___oktellsessionid"
    ]
  },
  "news": {
    "poll_seconds": 60,
    "unknown_state_grace_seconds": 60
  },
  "status": {
    "enabled": true,
    "socket_frames": {
      "training": [
        "setuserstate",
        {
          "onlunch": true,
          "lunchreasonid": 3
        }
      ],
      "restore": [
        "setuserstate",
        {
          "onlunch": false
        }
      ]
    },
    "selectors": {
      "training": "",
      "restore": ""
    },
    "http_fallback": true,
    "reapply_seconds": 30,
    "allow_insecure_tls": false
  },
  "update": {
    "check_hours": 4
  }
}