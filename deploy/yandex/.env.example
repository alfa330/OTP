# Образец .env для deploy/yandex. Рабочий файл — .env рядом (в git не попадает).
# Значения с «$» — в одинарных кавычках: compose иначе подставляет ${…}.
#
# Основная масса ключей (Oktell, Binotel, Wazzup, amoCRM, OLX, Fleet, Vertex и прочие
# интеграции, ~130 штук) переезжает из Render как есть:
#   python scripts/render_env_export.py
# Скрипт дописывает их в этот же файл, ниже перечислено только то, что он не знает.

# ── Адрес и образы ───────────────────────────────────────────────────────────
PUBLIC_HOST=portal.example.kz
ACME_EMAIL=admin@example.kz
# Реестр образов: cr.yandex/<id реестра>/otp → образы otp/api и otp/web.
IMAGE_PREFIX=cr.yandex/crpXXXXXXXXXXXXXXXX/otp
IMAGE_TAG=latest

# ── База ─────────────────────────────────────────────────────────────────────
# Managed Service for PostgreSQL: хост кластера (FQDN), пользователь и база.
# В кластере должны быть включены расширения vector, pg_trgm, pgcrypto (консоль или CLI:
# через SQL Managed PostgreSQL расширения не ставит) и max_connections не меньше 100.
# Для Postgres из docker-compose.localdb.yml: POSTGRES_HOST=db.
POSTGRES_HOST=rc1a-xxxxxxxxxxxxxxxx.mdb.yandexcloud.net
POSTGRES_PORT=6432
POSTGRES_DB=otp
POSTGRES_USER=otp
POSTGRES_PASSWORD=
# Проверка сертификата кластера (корневой сертификат уже в образе api.Dockerfile).
# Для Postgres в контейнере обе строки убрать.
PGSSLMODE=verify-full
PGSSLROOTCERT=/etc/ssl/certs/yandex-cloud-ca.pem
# Пул соединений API: как на Render (16..40); на маленьком кластере можно уменьшить.
POSTGRES_POOL_MIN_CONN=16
POSTGRES_POOL_MAX_CONN=40

# ── Обязательные для старта ──────────────────────────────────────────────────
BOT_TOKEN=
JWT_SECRET=

# ── Свой адрес ───────────────────────────────────────────────────────────────
# Ссылки в Telegram (задачи, обращения, вики) и проверка Origin на пишущих запросах:
# origin этого адреса добавляется в ALLOWED_ORIGINS автоматически.
TASK_WEB_APP_BASE_URL=https://portal.example.kz
# Дополнительные origin через запятую — например GitHub Pages на время переезда.
# CORS_EXTRA_ORIGINS=https://icorehub.kz

# ── Файлы (Google Cloud Storage остаётся) ────────────────────────────────────
# JSON сервисного аккаунта одной строкой; скрипт выгрузки кладёт его сам.
GOOGLE_APPLICATION_CREDENTIALS_CONTENT=
GOOGLE_CLOUD_STORAGE_BUCKET=
GOOGLE_CLOUD_STORAGE_BUCKET_TASKS=
GCS_BUCKET=

# ── waitress (значения по умолчанию те же, что на Render) ───────────────────
# WAITRESS_THREADS=96
# WAITRESS_CONN_LIMIT=180
# WAITRESS_CHANNEL_TIMEOUT=120
